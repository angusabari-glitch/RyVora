{
	"name": "ryvora",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite --host 127.0.0.1",
		"build": "tsc -b && vite build",
		"preview": "vite preview --host 127.0.0.1",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -b --pretty false",
		"lint": "biome ci .",
		"format": "biome format --write .",
		"data:validate": "node scripts/dataset.mjs validate",
		"data:seed": "node scripts/dataset.mjs seed"
	},
	"dependencies": {
		"@fontsource-variable/inter": "5.3.0",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@types/node": "26.6.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"exceljs": "4.4.0",
		"jsdom": "30.1.1",
		"typescript": "5.9.3",
		"vite": "8.3.0",
		"vitest": "5.0.1"
	}
}
